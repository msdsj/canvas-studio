{
  "additionalProperties": false,
  "description": "最终方案（前端消费的唯一契约，R04）。\n\n字段名集合被 `frontend/scripts/check-plan-schema.mjs` 与\n`frontend/src/lib/api/chat.ts` 的 `ComposePlan` 断言相等——改字段只改这里。",
  "properties": {
    "extra_notes": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extra Notes"
    },
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "title": {
      "maxLength": 60,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "subject": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Subject",
      "type": "string"
    },
    "aspect": {
      "enum": [
        "1:1",
        "3:4",
        "4:3",
        "9:16",
        "16:9"
      ],
      "title": "Aspect",
      "type": "string"
    },
    "negative": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Negative",
      "type": "string"
    },
    "final_prompt": {
      "maxLength": 800,
      "minLength": 40,
      "title": "Final Prompt",
      "type": "string"
    },
    "skill_id": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Skill Id",
      "type": "string"
    },
    "style_tags": {
      "items": {
        "maxLength": 40,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Style Tags",
      "type": "array"
    },
    "reasoning": {
      "items": {
        "maxLength": 80,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Reasoning",
      "type": "array"
    },
    "source": {
      "default": "relay",
      "enum": [
        "relay",
        "template_fallback",
        "verbatim"
      ],
      "title": "Source",
      "type": "string"
    },
    "prompt_truncated": {
      "default": false,
      "title": "Prompt Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "title",
    "subject",
    "aspect",
    "negative",
    "final_prompt",
    "skill_id",
    "style_tags",
    "reasoning"
  ],
  "title": "ComposePlan",
  "type": "object"
}
