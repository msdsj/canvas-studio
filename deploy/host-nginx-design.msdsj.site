# canvas-studio（MSDSJ AI画布）—— 宿主机 nginx 站点配置
#
# 部署位置：/etc/nginx/sites-available/design.msdsj.site
#           软链到 /etc/nginx/sites-enabled/
#
# 反代到 Docker 内的 frontend(127.0.0.1:8801)，它内部再转 backend/gateway。
# 证书：Let's Encrypt，DNS-01 验证（本机 80 端口被云厂商封锁，不可用 HTTP-01）
#
# ⚠️ 证书续期：design 的 certbot auto-renew 已被移出
#    （/etc/letsencrypt/renewal-disabled/），2027-01-23 前必须手动续期，
#    或配好火山引擎 AK/SK 走 DNS-01 自动化。
#
# 更新：2026-10-26（新增 /static/ 独立段：大图缓存透传）

map $http_upgrade $connection_upgrade_cs {
    default upgrade;
    ''      close;
}

# HTTP：仅保留 ACME 校验，其余全部跳 HTTPS
server {
    listen 80;
    server_name design.msdsj.site;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name design.msdsj.site;

    ssl_certificate     /etc/letsencrypt/live/design.msdsj.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/design.msdsj.site/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # 上传素材/画布导出
    client_max_body_size 50m;

    # 用户图片（生成结果 / 上传素材 / 缩略图）。
    #
    # 缓存头由内层 frontend nginx 生成（public, max-age=31536000, immutable），
    # 这里**不要**再加 expires / add_header，否则响应里会出现两个 Cache-Control，
    # 部分中间代理会取到错的那个。这里只做透传 + 给足缓冲。
    location /static/ {
        proxy_pass http://127.0.0.1:8801;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 条件请求要能穿透，否则 304 拿不到、每次都重下整张图
        proxy_set_header If-None-Match     $http_if_none_match;
        # 图片是大文件，让内核缓冲，别在 user space 反复拷贝
        proxy_buffering on;
        proxy_buffers 8 128k;
        proxy_busy_buffers_size 256k;
        proxy_read_timeout 120s;
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:8801;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 协作画布 WebSocket：缺这段会一直显示「协作未连接」
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade_cs;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
