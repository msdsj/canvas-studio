# 部署级环境变量（docker compose 读取）
# 安全
CS_SECRET_KEY=change-me-in-production
CS_GATEWAY_INTERNAL_TOKEN=change-me-internal-token

# 管理员
CS_DEFAULT_ADMIN_EMAIL=admin@canvas.studio
CS_DEFAULT_ADMIN_PASSWORD=Admin@12345

# Demo 模式：auto | on | off
CS_DEMO_MODE=auto

# 上游（本地↔线上切换只改这两组）
SUB2API_BASE_URL=http://sub2api:8080
SUB2API_API_KEY=sk-xxx
CHATGPT2API_BASE_URL=http://chatgpt2api:3000
CHATGPT2API_ADMIN_KEY=xxx

# 服务器 VPN 代理（网关 httpx 使用）
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,backend,gateway,chatgpt2api,sub2api

# 上游镜像（可选 profile）
CHATGPT2API_IMAGE=chatgpt2api:latest
SUB2API_IMAGE=sub2api:latest
