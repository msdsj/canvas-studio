# 部署级环境变量（docker compose 读取）
# 安全
CS_SECRET_KEY=change-me-in-production
CS_GATEWAY_INTERNAL_TOKEN=change-me-internal-token

# 管理员
CS_DEFAULT_ADMIN_EMAIL=admin@canvas.studio
CS_DEFAULT_ADMIN_PASSWORD=Admin@12345

# Demo 模式：auto | on | off
CS_DEMO_MODE=off

# 生图并发：每个后端进程同时调用上游的任务数；超出后进入队列
CS_IMAGE_CONCURRENCY=4
CS_IMAGE_QUEUE_MAX=200
CS_MAX_ACTIVE_TASKS_PER_USER=12

# 通用第三方 provider（OpenAI 兼容；可在 /admin/config 中修改并测试）
TEXT_API_BASE_URL=
TEXT_API_KEY=
TEXT_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2

# 服务器 VPN 代理（网关 httpx 使用）
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,backend,gateway
