# msdsj backend 环境变量样例（前缀 CS_）
CS_SECRET_KEY=dev-change-me
CS_JWT_ALGORITHM=HS256
CS_ACCESS_TOKEN_TTL=604800
CS_DATABASE_URL=sqlite+aiosqlite:///./data/canvas_studio.db
CS_STORAGE_BACKEND=local
CS_STORAGE_DIR=./data/storage
CS_STORAGE_PUBLIC_BASE=http://localhost:8000/static
CS_FRONTEND_BASE_URL=http://localhost:5173
CS_CORS_ORIGINS=http://localhost:5173
CS_GATEWAY_BASE_URL=http://localhost:8100
CS_GATEWAY_INTERNAL_TOKEN=dev-internal-token
CS_DEFAULT_ADMIN_EMAIL=admin@canvas.studio
CS_DEFAULT_ADMIN_PASSWORD=Admin@12345
CS_INITIAL_GRANT=200
CS_VERIFY_TOKEN_TTL_HOURS=24
CS_RESET_TOKEN_TTL_HOURS=1
CS_QUOTA_PRICE_IMAGE=10
CS_QUOTA_PRICE_IMAGE_HD=16
CS_QUOTA_PRICE_EDIT=8
CS_QUOTA_PRICE_CHAT=2
CS_QUOTA_WARN_PCT=20
CS_OPEN_REGISTRATION=true
CS_MAINTENANCE_MODE=false
CS_POOL_AUTOREFRESH_MINUTES=30
CS_MAX_UPLOAD_MB=20
CS_EMAIL_BACKEND=console
CS_SMTP_HOST=
CS_SMTP_PORT=587
CS_SMTP_USER=
CS_SMTP_PASSWORD=
CS_SMTP_FROM=no-reply@canvas.studio
CS_SMTP_TLS=true
CS_DEMO_MODE=off
CS_MAX_ACTIVE_TASKS_PER_USER=2
CS_IDEMPOTENCY_WINDOW_SECONDS=300
CS_TASK_TIMEOUT_SECONDS=180
CS_TASK_ORPHAN_SCAN_SECONDS=60
CS_GW_CONNECT_TIMEOUT=10
CS_GW_READ_TIMEOUT=300
CS_GW_MAX_RETRIES=2
CS_POLL_BASE_INTERVAL_MS=1500
CS_POLL_MAX_INTERVAL_MS=10000

# 通用第三方 provider（沿用原生名，无 CS_ 前缀）
TEXT_API_BASE_URL=
TEXT_API_KEY=
TEXT_MODEL=gpt-4o-mini
