# canvas-studio 仓库根环境变量汇总入口
# 复制为 .env 后按需修改；各组件亦可用自身 .env（backend/.env、gateway/.env、frontend/.env）

# ---- 后端（CS_ 前缀）----
CS_SECRET_KEY=dev-change-me
CS_DATABASE_URL=sqlite+aiosqlite:///./data/canvas_studio.db
CS_STORAGE_DIR=./data/storage
CS_STORAGE_PUBLIC_BASE=http://localhost:8000/static
CS_FRONTEND_BASE_URL=http://localhost:5173
CS_CORS_ORIGINS=http://localhost:5173
CS_GATEWAY_BASE_URL=http://localhost:8100
CS_GATEWAY_INTERNAL_TOKEN=dev-internal-token
CS_DEFAULT_ADMIN_EMAIL=admin@canvas.studio
CS_DEFAULT_ADMIN_PASSWORD=Admin@12345
CS_DEMO_MODE=auto

# ---- 网关 ----
# CS_GATEWAY_INTERNAL_TOKEN 与后端共享；CS_GW_CONNECT_TIMEOUT / CS_GW_READ_TIMEOUT / CS_GW_MAX_RETRIES

# ---- 上游（本地↔线上切换开关：只改这两组地址/密钥）----
SUB2API_BASE_URL=http://localhost:8080
SUB2API_API_KEY=sk-xxx
CHATGPT2API_BASE_URL=http://localhost:3000
CHATGPT2API_ADMIN_KEY=xxx

# ---- 服务器 VPN 代理 ----
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# ---- 前端 ----
VITE_API_BASE_URL=/api
